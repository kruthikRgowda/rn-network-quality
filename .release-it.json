{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commit": true,
    "commitMessage": "chore: release ${version}",
    "push": true,
    "requireCleanWorkingDir": true,
    "tag": true,
    "tagName": "v${version}"
  },
  "github": {
    "release": true
  },
  "npm": {
    "publish": true,
    "skipChecks": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "header": "# Changelog\n\nThis file is generated by release-it from Conventional Commits.",
      "infile": "CHANGELOG.md",
      "preset": "conventionalcommits"
    }
  }
}
